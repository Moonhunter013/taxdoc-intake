# Copy to .env (never commit .env). Values here are for local development only.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=taxdoc
MYSQL_USER=taxdoc
MYSQL_PASSWORD=change-me

# Used when running the extraction service outside Docker (uv run uvicorn ...). Use the same
# user/password as above. Inside docker compose this is set automatically.
EXTRACTION_DATABASE_URL=mysql+pymysql://taxdoc:change-me@localhost:3306/taxdoc

# AWS (Week 1). Prefer `aws configure --profile taxdoc` over putting keys here.
AWS_PROFILE=taxdoc
AWS_REGION=us-east-1
EXTRACTION_S3_BUCKET=taxdoc-intake-dev-uploads-CHANGE-ME

# Secret for hashing SSNs/EINs (ADR-0005). Generate your own; never reuse this placeholder:
#   python -c "import secrets; print(secrets.token_hex(32))"
EXTRACTION_TIN_HMAC_KEY=replace-with-64-hex-characters
